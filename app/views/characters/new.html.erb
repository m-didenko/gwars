<h1>Create your character</h1>

<%= form_with model: @character, url: character_path do |f| %>
  <% if @character.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @character.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <p class="tag">Starting tank: 100 HP, 30 max damage, 2 armor.</p>

  <%= f.submit "Create character" %>
<% end %>
