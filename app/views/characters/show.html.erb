<h1><%= @character.name %></h1>

<ul class="card-list">
  <li><span>Max HP</span><strong><%= @character.max_hp %></strong></li>
  <li><span>Firepower (max damage)</span><strong><%= @character.attack * 3 %></strong></li>
  <li><span>Armor</span><strong><%= @character.defense %></strong></li>
</ul>

<p class="back-link"><%= link_to "← Back to battles", battles_path %></p>
