<%#
  Every panel is rendered once and toggled by battle_controller.js. None of the
  markup depends on whose turn it is, so the browser can move between states
  without ever asking the server for HTML again — state arrives over
  BattleChannel as JSON.
%>
<div class="battle"
     data-controller="battle"
     data-battle-id-value="<%= @battle.id %>"
     data-battle-my-side-value="<%= @battle.side_of(current_character) %>"
     data-battle-name-one-value="<%= @battle.player_one.name %>"
     data-battle-name-two-value="<%= @battle.player_two.name %>"
     data-battle-state-value="<%= @battle.state_payload(current_character).to_json %>">

  <header class="hud">
    <div class="hud-side hud-side--one <%= "is-you" if @battle.player_one == current_character %>">
      <div class="hud-label">
        <%= @battle.player_one == current_character ? "YOU" : "ENEMY" %>
        <span class="hud-name"><%= @battle.player_one.name %></span>
      </div>
      <div class="hud-hp">
        HP: <span data-battle-target="hpTextOne">—</span> / <%= @battle.player_one.max_hp %>
        <span class="hud-miss" data-battle-target="missOne" hidden>MISSED <span data-battle-target="missTextOne">—</span>/<%= Battle::MAX_MISSED_TURNS %></span>
      </div>
      <div class="hp-track"><div class="hp-fill" data-battle-target="hpBarOne"></div></div>
    </div>

    <div class="hud-turn">
      <div class="hud-turn-number" data-battle-target="turnNumber">—</div>
      <div class="hud-turn-role" data-battle-target="roleLabel">—</div>
      <div class="hud-turn-clock" data-battle-target="clock" hidden>
        <span data-battle-target="clockValue">—</span>s
      </div>
    </div>

    <div class="hud-side hud-side--two <%= "is-you" if @battle.player_two == current_character %>">
      <div class="hud-label">
        <%= @battle.player_two == current_character ? "YOU" : "ENEMY" %>
        <span class="hud-name"><%= @battle.player_two.name %></span>
      </div>
      <div class="hud-hp">
        HP: <span data-battle-target="hpTextTwo">—</span> / <%= @battle.player_two.max_hp %>
        <span class="hud-miss" data-battle-target="missTwo" hidden>MISSED <span data-battle-target="missTextTwo">—</span>/<%= Battle::MAX_MISSED_TURNS %></span>
      </div>
      <div class="hp-track"><div class="hp-fill" data-battle-target="hpBarTwo"></div></div>
    </div>
  </header>

  <%= render "battles/field" %>

  <p class="flash flash--alert battle-error" data-battle-target="error" hidden></p>

  <section class="controls">
    <div class="panel panel--aim" data-battle-target="aimPanel" hidden>
      <h2>AIM YOUR SHOT</h2>
      <p class="hint">
        Aim with the mouse, then click the field — or press FIRE. The marked band
        is everywhere the enemy could roll to. Miss the
        <%= Battle::TURN_SECONDS %>-second clock and you do not fire at all.
      </p>
      <button type="button" class="btn btn--fire"
              data-battle-target="fireButton" data-action="battle#fire" disabled>FIRE</button>
    </div>

    <div class="panel panel--info" data-battle-target="infoPanel" hidden>
      <h2>WEAPON INFO</h2>
      <dl>
        <div><dt>TARGET</dt><dd data-battle-target="targetOut">—</dd></div>
        <div><dt>ANGLE</dt><dd data-battle-target="angleOut">—</dd></div>
        <div><dt>DEAD CENTRE</dt><dd><%= Battle::DAMAGE_BANDS.first.last %></dd></div>
        <div><dt>TREADS</dt><dd><%= Battle::DAMAGE_BANDS[2].last %></dd></div>
        <div><dt>SHRAPNEL</dt><dd><%= Battle::DAMAGE_BANDS.last.last %></dd></div>
        <div><dt>WIND</dt><dd>0</dd></div>
      </dl>
    </div>

    <div class="panel panel--move panel--wide" data-battle-target="movePanel" hidden>
      <h2>MOVE YOUR TANK</h2>
      <p class="hint">
        Click inside the marked band to roll there — that locks your move in.
        The enemy is aiming right now, and if the
        <%= Battle::TURN_SECONDS %>-second clock runs out you stay put.
      </p>
      <div class="move-options">
        <% Battle::MOVE_PRESETS.each do |delta| %>
          <button type="button" class="move-btn"
                  data-delta="<%= delta %>"
                  data-action="battle#selectMove"><%= delta.positive? ? "+#{delta}" : delta %></button>
        <% end %>
      </div>
      <div class="move-footer">
        <span>ROLL TO: <strong data-battle-target="positionOut">—</strong></span>
      </div>
    </div>

    <div class="panel panel--wide" data-battle-target="waitPanel" hidden>
      <h2 data-battle-target="waitTitle">WAITING</h2>
      <p class="hint" data-battle-target="waitNote"></p>
    </div>

    <div class="panel panel--wide" data-battle-target="acceptPanel" hidden>
      <h2>INCOMING CHALLENGE</h2>
      <p class="hint"><%= @battle.player_one.name %> wants a duel.</p>
      <button type="button" class="btn btn--primary" data-action="battle#accept">ACCEPT CHALLENGE</button>
    </div>

    <div class="panel panel--wide panel--result" data-battle-target="resultPanel" hidden>
      <h2 data-battle-target="resultTitle">—</h2>
      <p data-battle-target="resultNote"></p>
      <%= link_to "Back to lobby", lobby_path, class: "btn" %>
    </div>
  </section>

  <footer class="ticker" data-battle-target="ticker" hidden></footer>
</div>

<p class="back-link"><%= link_to "← Back to lobby", lobby_path %></p>
