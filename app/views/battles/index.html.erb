<h1>Battles</h1>

<p class="tag">
  COMMANDER: <strong><%= current_character.name %></strong> ·
  MAX HP <%= current_character.max_hp %> · DEAD CENTRE HIT <%= Battle::DAMAGE_BANDS.first.last %>
</p>

<p class="hint">
  Opponents are matched at random — <%= link_to "join the queue", character_path %> to
  start one.
</p>

<h2>Your battles</h2>
<% if @battles.empty? %>
  <ul class="card-list"><li>No battles yet.</li></ul>
<% else %>
  <ul class="card-list">
    <% @battles.each do |battle| %>
      <li>
        <%= link_to "#{battle.player_one.name} vs #{battle.player_two.name}", battle_path(battle) %>
        <span class="tag">
          <%= battle.status.upcase %>
          <%= "· TURN #{battle.turn_number}" if battle.active? %>
          <%= "· WINNER: #{battle.winner.name}" if battle.finished? && battle.winner %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
