<h1>Tank Battle Online</h1>

<p class="tag">
  COMMANDER: <strong><%= current_character.name %></strong> ·
  MAX HP <%= current_character.max_hp %> · FIREPOWER <%= current_character.attack * 3 %> · ARMOR <%= current_character.defense %>
</p>

<h2>Challenge a commander</h2>
<% if @opponents.empty? %>
  <ul class="card-list"><li>No other commanders yet — ask a friend to sign up.</li></ul>
<% else %>
  <ul class="card-list">
    <% @opponents.each do |opponent| %>
      <li>
        <span><%= opponent.name %> <span class="tag">· MAX HP <%= opponent.max_hp %></span></span>
        <%= button_to "CHALLENGE", battles_path(opponent_id: opponent.id), method: :post, class: "btn" %>
      </li>
    <% end %>
  </ul>
<% end %>

<h2>Your battles</h2>
<% if @battles.empty? %>
  <ul class="card-list"><li>No battles yet.</li></ul>
<% else %>
  <ul class="card-list">
    <% @battles.each do |battle| %>
      <li>
        <%= link_to "#{battle.player_one.name} vs #{battle.player_two.name}", battle_path(battle) %>
        <span class="tag">
          <%= battle.status.upcase %>
          <%= "· TURN #{battle.turn_number}" if battle.active? %>
          <%= "· WINNER: #{battle.winner.name}" if battle.finished? && battle.winner %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
